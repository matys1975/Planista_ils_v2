# Planista ILS v2 - przykladowy plik .env
# Skopiuj ten plik jako .env i uzupelnij wartosci przed wdrozeniem.
#
# Przyklady generowania sekretow:
# PowerShell: [System.Guid]::NewGuid().ToString("N")
# Bash:       openssl rand -base64 32

# === PostgreSQL ===
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=plan_db

# === Redis ===
REDIS_PASSWORD=

# === MinIO ===
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=

# === Aplikacja ===
JWT_SECRET=
CORS_ORIGIN=http://localhost:3001
COOKIE_SECURE=true
LOG_LEVEL=info
BACKUP_DIR=/app/backups
SEED_DB=false

# === Pierwszy SUPER_ADMIN ===
# Konto jest tworzone tylko wtedy, gdy baza jest pusta.
INITIAL_ADMIN_EMAIL=admin@planista.local
INITIAL_ADMIN_PASSWORD=

# === Opcjonalne / development ===
# VITE_API_HOST=127.0.0.1
# VITE_API_PORT=3334
# USOS_API_URL=https://usosapps.amu.edu.pl
# USOS_CONSUMER_KEY=
# USOS_CONSUMER_SECRET=
