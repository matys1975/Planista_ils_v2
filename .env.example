# ═══════════════════════════════════════════════════════════════
# Planista ILS — Zmienne środowiskowe
# Skopiuj ten plik jako .env i uzupełnij wartości
#
# ⚠️  WAŻNE: Wygeneruj losowe hasła przed wdrożeniem!
# Przykład generowania (PowerShell):
#   [System.Guid]::NewGuid().ToString("N")
# Przykład generowania (bash):
#   openssl rand -base64 32
# ═══════════════════════════════════════════════════════════════

# === Baza danych (PostgreSQL) ===
POSTGRES_USER=planista
POSTGRES_PASSWORD=          # ← WYMAGANE: wygeneruj losowe hasło (min. 20 znaków)
POSTGRES_DB=plan_db

# === Redis ===
REDIS_PASSWORD=             # ← WYMAGANE: wygeneruj losowe hasło

# === MinIO (object storage) ===
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=        # ← WYMAGANE: wygeneruj losowe hasło (min. 20 znaków)

# === Aplikacja ===
JWT_SECRET=                 # ← WYMAGANE: wygeneruj losowy klucz (min. 32 znaki)
CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info
NODE_ENV=production

# === Opcjonalne ===
# SEED_DB=true           # Uruchom seed bazy przy starcie (tylko raz)
# BACKUP_DIR=/app/backups # Ścieżka do katalogu backupów

# === Domyślne konto admina (tworzone automatycznie gdy baza jest pusta) ===
# DEFAULT_ADMIN_EMAIL=admin@planista.local
# DEFAULT_ADMIN_PASSWORD=admin123
# ⚠️  Zmień hasło po pierwszym zalogowaniu!
